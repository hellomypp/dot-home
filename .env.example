# Copy to .env locally. Never commit real credentials.
DB_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DB_URL=jdbc:mysql://127.0.0.1:3306/dothome?serverTimezone=UTC
DB_USER=dothome
APP_ORIGIN=http://127.0.0.1:5173
# Production only: enable the kakao profile, HTTPS, and VITE_KAKAO_ENABLED=true.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
