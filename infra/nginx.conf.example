# Merge into a TLS-enabled server block after configuring your own certificate.
# This file is a deployment template, not a deployed or verified HTTPS endpoint.
server {
    listen 443 ssl;
    server_name your-domain.example;
    ssl_certificate /etc/ssl/dothome/fullchain.pem;
    ssl_certificate_key /etc/ssl/dothome/privkey.pem;
    root /srv/dothome/web;
    add_header Referrer-Policy no-referrer always;
    location / { try_files $uri $uri/ /index.html; }
    location ~ ^/(api|oauth2|login/oauth2)/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
    }
}
